MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1342739285}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 183842b0140aac94f9a9352ecf96de59, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ColonStory
  rider: {fileID: 0}
  questionPanel: {fileID: 1623368611}
  introKey: Darm_Intro
  introDelay: 1.5
  endKey: Darm_Einde
  showInstruction: 1
  instructionTopic: Even uitleggen
  instructionTitle: Zo beantwoord je de vragen
  instructionText: 'Bij elke poliep stelt de dokter je een vraag.


    Kies een antwoord door ernaar te kijken tot de kaart helemaal opgevuld is, zoals in het voorbeeld hieronder. Het witte puntje toont waar je kijkt.


    Fout antwoorden is niet erg: je krijgt altijd uitleg.


    Probeer het nu met de knop onderaan.'
  instructionButton: "Begrepen  \u203A"
  showInstructionDemo: 1
  stations:
  - stage: 1
    sequenceKey: Darm_Poliep1
    question: {fileID: 11400000, guid: 6d283f43ad91b3a47abc1c19306f7194, type: 2}
  - stage: 2
    sequenceKey: Darm_Poliep2
    question: {fileID: 11400000, guid: 1d5c72e73f4f6a94f8833f461e624cd1, type: 2}
  - stage: 3
    sequenceKey: Darm_Poliep3
    question: {fileID: 11400000, guid: 5758b84622c44cc4db6d06bf8011b0c7, type: 2}
  - stage: 4
    sequenceKey: Darm_Poliep4
    question: {fileID: 11400000, guid: 85e69bc4afae77e4c8822de39363cb6c, type: 2}
  trigger: 1
  inspectFallback: 4
  holdPlayerDuringStation: 1
  onStoryStarted:
    m_PersistentCalls:
      m_Calls: []
  onStoryFinished:
    m_PersistentCalls:
      m_Calls: []
--- !u!114 &1342739287
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1342739285}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bcf769492ed6f7d4d97fe6fcebf305fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Oncologie.Dialogue.DialogueManager
  voiceAudioSource: {fileID: 0}
  useScriptLines: 0
  sequences:
  - sequenceKey: Darm_Intro
    description: Start van de wandeling, gezonde darm
    lines:
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Welkom in de dikke darm van Luc. Anderhalve meter lang, en hij voelt er helemaal niets van.
      voiceClip: {fileID: 0}
      displayDuration: 5.5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Kijk maar rond. Roze, glad en glanzend. Zo hoort het eruit te zien.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Loop verder. Ergens hier begint iets heel kleins.
      voiceClip: {fileID: 0}
      displayDuration: 3.5
      pauseAfter: 0.4
  - sequenceKey: Darm_Poliep1
    description: 'Stadium 1: kleine poliep'
    lines:
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Zie je dat bobbeltje op de wand? Dat is een poliep.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Een groepje cellen dat net iets te snel groeit. Meestal is dat nog onschuldig.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Geen pijn. Geen bloed dat Luc kan zien. Niets.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Luc (van ver)
      speakerColor: {r: 0.45, g: 0.8, b: 1, a: 1}
      subtitleText: "Ik voel mij kiplekker, h\xE8."
      voiceClip: {fileID: 0}
      displayDuration: 3
      pauseAfter: 0.4
  - sequenceKey: Darm_Poliep2
    description: 'Stadium 2: poliep groeit, wand ontstoken'
    lines:
    - speakerName: Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Een tijd later. De brief van het bevolkingsonderzoek hangt nog altijd op de frigo.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: 'De poliep is gegroeid. Kijk naar de wand errond: rood en ontstoken.'
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Soms bloedt hij een heel klein beetje. Te weinig om te zien, maar de stoelgangtest vindt het wel.
      voiceClip: {fileID: 0}
      displayDuration: 6
      pauseAfter: 0.4
  - sequenceKey: Darm_Poliep3
    description: 'Stadium 3: cellen worden kwaadaardig'
    lines:
    - speakerName: Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Weer jaren later. Nog altijd geen test.
      voiceClip: {fileID: 0}
      displayDuration: 3.5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Dit is geen onschuldig knobbeltje meer. Sommige cellen zijn kwaadaardig geworden.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: "Nu kan het nog. Bij een coloscopie halen we zo'n poliep vaak in \xE9\xE9n keer weg."
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Luc (van ver)
      speakerColor: {r: 0.45, g: 0.8, b: 1, a: 1}
      subtitleText: Volgend jaar doe ik die test wel.
      voiceClip: {fileID: 0}
      displayDuration: 3
      pauseAfter: 0.4
  - sequenceKey: Darm_Poliep4
    description: 'Stadium 4: tumor, necrose'
    lines:
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Dit is een tumor. Het weefsel errond sterft af.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: Hij groeit door de darmwand heen. Van hieruit kan de kanker uitzaaien.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dokter
      speakerColor: {r: 0.5, g: 0.95, b: 0.85, a: 1}
      subtitleText: En al die tijd voelde Luc... niets.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
  - sequenceKey: Darm_Einde
    description: Einde van de darm
    lines:
    - speakerName: Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Darmkanker begint bijna altijd als een poliep. En een poliep doet geen pijn.
      voiceClip: {fileID: 0}
      displayDuration: 5.5
      pauseAfter: 0.4
    - speakerName: Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: "De stoelgangtest vindt het v\xF3\xF3r je iets voelt. Gratis, thuis, om de twee jaar, van 50 tot 74 jaar."
      voiceClip: {fileID: 0}
      displayDuration: 6.5
      pauseAfter: 0.4
  onLineStarted:
    m_PersistentCalls:
      m_Calls: []
  onSequenceFinished:
    m_PersistentCalls:
      m_Calls: []
