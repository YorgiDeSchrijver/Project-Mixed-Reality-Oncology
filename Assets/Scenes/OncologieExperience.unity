--- !u!114 &1369763190
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1369763189}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bcf769492ed6f7d4d97fe6fcebf305fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Oncologie.Dialogue.DialogueManager
  voiceAudioSource: {fileID: 0}
  sequences:
  - sequenceKey: Intro_Keuken
    description: Vader en kind bij het aanrecht
    lines:
    - speakerName: Vader Luc (58)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Zo, de koffie pruttelt. Gezellig dat je er bent vandaag!
      voiceClip: {fileID: 0}
      displayDuration: 3.5
      pauseAfter: 0.4
    - speakerName: Vader Luc (58)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Kijk, er lag vanochtend weer zo'n paarse brief van het Bevolkingsonderzoek op de mat.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Vader Luc (58)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Ach joh, ik ben pas 58 en kerngezond. Die test doe ik volgend jaar wel.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Vader Luc (58)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Ik ga even de hond uitlaten. Leg die envelop maar ergens neer.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Jij (Perspectief)
      speakerColor: {r: 0.9, g: 0.9, b: 0.9, a: 1}
      subtitleText: Wat doe je met de brief? Leg je hem bij het oud papier (A), of leg je hem bij zijn autosleutels (B)?
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
  - sequenceKey: Keuze_A_Negeren
    description: Brief bij oud papier gelegd
    lines:
    - speakerName: Jij (Perspectief)
      speakerColor: {r: 0.9, g: 0.9, b: 0.9, a: 1}
      subtitleText: Hij voelt zich prima... ik leg de brief wel bij het oud papier.
      voiceClip: {fileID: 0}
      displayDuration: 3.5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: De brief belandt ongebruikt bij het afval. Drie cruciale jaren beginnen nu geruisloos te tikken...
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
  - sequenceKey: Keuze_B_Aandringen
    description: Brief bij autosleutels gelegd
    lines:
    - speakerName: Jij (Perspectief)
      speakerColor: {r: 0.9, g: 0.9, b: 0.9, a: 1}
      subtitleText: Nee pap, 58 is precies de doelgroep. Geen uitstel meer, doe deze test.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Vader Luc (58)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Nou vooruit dan maar... omdat jij zo aandringt. Ik stuur de test vanavond nog op.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: De testkit wordt verzonden naar het laboratorium voor analyse.
      voiceClip: {fileID: 0}
      displayDuration: 3.5
      pauseAfter: 0.4
  - sequenceKey: Darm_Intro
    description: Binnenkomst in de dikke darm
    lines:
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Welkom in het binnenste van de dikke darm, op cellulair micro-niveau.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Kijk om je heen. Het slijmvlies is vochtig, roze en volkomen intact.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: 'Maar kijk hier naar deze kleine zwelling aan de wand: een adenoom, een goedaardige poliep.'
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: "Luc merkt hier helemaal niets van. Geen pijn, geen bloed in het toilet. Maar de iFOBT-test ontdekt microscopische sporen w\xE9l!"
      voiceClip: {fileID: 0}
      displayDuration: 5.5
      pauseAfter: 0.4
  - sequenceKey: Darm_Route_A_Kanker
    description: Onbehandelde poliep muteert en groeit
    lines:
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: 3 jaar later...
      voiceClip: {fileID: 0}
      displayDuration: 3
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: Omdat de brief werd genegeerd, hebben de cellen zich ongehinderd kunnen delen.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: De kleine poliep is nu gemuteerd tot een kwaadaardige tumor (Stadium 4).
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: De tumor breekt door de darmwand heen en infiltreert de bloedvaten. Uitzaaiing.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: Pas nu krijgt Luc klachten... maar nu is genezing bijzonder moeilijk.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
  - sequenceKey: Darm_Route_B_Genezing
    description: Coloscopie verwijdert poliep
    lines:
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Dankzij de tijdige stoelgangtest sloeg het laboratorium alarm.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Tijdens een eenvoudige coloscopie wordt de poliep met een lisje pijnloos weggesneden.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: De darmwand heelt snel. Kanker heeft hier nooit een kans gekregen.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
  - sequenceKey: Einde_Slecht
    description: Gevolgen van negeren
    lines:
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: De keuken is stil en koud. Vader is er niet meer.
      voiceClip: {fileID: 0}
      displayDuration: 4
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.45, b: 0.4, a: 1}
      subtitleText: Darmkanker geeft pas laat merkbare klachten. Wachten kost levens.
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Systeem
      speakerColor: {r: 0.9, g: 0.9, b: 0.9, a: 1}
      subtitleText: Druk op [R] op je toetsenbord of richt op de knop om de tijd terug te spoelen.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
  - sequenceKey: Einde_Goed
    description: Gevolgen van vroege actie
    lines:
    - speakerName: Vader Luc (61)
      speakerColor: {r: 0.35, g: 0.78, b: 1, a: 1}
      subtitleText: Wat ben ik dankbaar dat je me die dag overtuigd hebt om die test te doen!
      voiceClip: {fileID: 0}
      displayDuration: 4.5
      pauseAfter: 0.4
    - speakerName: Dr. Verteller
      speakerColor: {r: 1, g: 0.82, b: 0.35, a: 1}
      subtitleText: Vroege opsporing redt jaarlijks duizenden levens. Doe mee aan het bevolkingsonderzoek.
      voiceClip: {fileID: 0}
      displayDuration: 5
      pauseAfter: 0.4
  onLineStarted:
    m_PersistentCalls:
      m_Calls: []
  onSequenceFinished:
    m_PersistentCalls:
      m_Calls: []
